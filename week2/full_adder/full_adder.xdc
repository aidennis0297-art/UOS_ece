# Full Adder 핀 제약 파일 (FPGA: Spartan-7 xc7s75fgga484-1)
# DIP Switch (Inputs)
set_property IOSTANDARD LVCMOS33 [get_ports DIP1]
set_property PACKAGE_PIN Y1 [get_ports DIP1]

set_property IOSTANDARD LVCMOS33 [get_ports DIP2]
set_property PACKAGE_PIN W3 [get_ports DIP2]

set_property IOSTANDARD LVCMOS33 [get_ports DIP3]
set_property PACKAGE_PIN U2 [get_ports DIP3]

# LED (Outputs)
set_property IOSTANDARD LVCMOS33 [get_ports LED1]
set_property PACKAGE_PIN L4 [get_ports LED1]

set_property IOSTANDARD LVCMOS33 [get_ports LED2]
set_property PACKAGE_PIN M4 [get_ports LED2]
